		lineageTag: f3caa204-4050-46a3-ba50-e4eb7fcb3980

	measure 'Facturación RAPIDAS Y FURIOSAS' = CALCULATE([Total Facturado], 'Libro de Excel'[Modulo] = "RAPIDAS Y FURIOSAS")
