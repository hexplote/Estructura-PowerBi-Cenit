		lineageTag: 3c41391c-4a97-444f-97f1-d7da85b65271

		annotation PBI_FormatHint = {"currencyCulture":"es-CO"}

	measure 'Modulo Promedio' = DIVIDE([Total Facturado], [Total lecturas])
